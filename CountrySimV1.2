        document.getElementById('diplomacyInfo').innerHTML = '建交: ' + dipl.warCount + ' | 断交: ' + dipl.peaceCount +
            ' | 盟友: ' + dipl.allies;
        let famineText = state.famineLevel === 1 ? '⚠️ 饥荒I' : (state.famineLevel === 2 ? '⚠️ 饥荒II' : '');
        document.getElementById('famineInfo').innerText = famineText;
        let pandemicText = state.pandemic.active ? '🦠 疫情中 (' + state.pandemic.daysLeft + '天)' : '';
        document.getElementById('pandemicInfo').innerText = pandemicText;
