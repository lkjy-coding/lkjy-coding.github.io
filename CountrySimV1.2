    // =====================================================================
    //  天气
    // =====================================================================
    function generateWeather() {
        const month = state.date.month;
        const isWinter = (month >= 11 || month <= 2);
        const isSummer = (month >= 6 && month <= 8);
        let r = Math.random() * 100;
        if (r < 60) return { name: '晴', type: 'normal', effect: 'good', duration: rand(1, 3) };
        if (r < 75) {
            if (isWinter) return { name: pick(['小雪', '中雪', '阴']), type: 'normal', effect: 'normal', duration: rand(1, 2) };
            else return { name: pick(['小雨', '中雨', '阴']), type: 'normal', effect: 'good', duration: rand(1, 2) };
        }
        let pool = [];
        if (isWinter) pool = ['暴风雪', '寒潮', '冰雹', '大雪'];
        else if (isSummer) pool = ['龙卷风', '热带风暴', '台风', '雷阵雨', '大雨', '冰雹', '高温'];
        else pool = ['中雨', '大雨', '雷阵雨', '冰雹', '大风'];
        let name = pick(pool);
        let effect = 'bad';
        let duration = rand(1, 3);
        if (name === '高温') duration = rand(7, 15);
        if (name === '台风') duration = rand(20, 30);
        if (name === '地震') duration = rand(15, 20);
        return { name, type: 'storm', effect, duration };
    }

    function updateWeather() {
        const w = generateWeather();
        state.weather = w;
        document.getElementById('weatherDisplay').innerHTML = w.name + (w.effect === 'bad' ? ' ⚠️' : '');
        if (w.name === '台风' && !state.flag.firstTyphoon) { state.flag.firstTyphoon = true;
            unlockAchievement('【啊啊啊啊——放我下来——】'); }
        if (w.name === '地震' && !state.flag.firstEarthquake) { state.flag.firstEarthquake = true;
            unlockAchievement('【大地在移动！】'); }
        if (w.name === '高温' && !state.flag.firstHeat) { state.flag.firstHeat = true;
            unlockAchievement('【蝉在鸣叫】'); }
        if (w.name === '干旱' && !state.flag.firstDrought) { state.flag.firstDrought = true;
            unlockAchievement('【龟裂】'); }
        if (w.name === '洪水' && !state.flag.firstFlood) { state.flag.firstFlood = true;
            unlockAchievement('【决堤】'); }
        if (w.name.includes('雨') && !state.flag.firstRain) { state.flag.firstRain = true;
            unlockAchievement('【下雨啦！收衫啦！】'); }
        if (w.name.includes('雪') && !state.flag.firstSnow) { state.flag.firstSnow = true;
            unlockAchievement('【雪！是雪！】'); }
        if (w.name === '大风' && !state.flag.firstWind) { state.flag.firstWind = true;
            unlockAchievement('【刮风咯——】'); }
        if (w.name === '寒潮' && !state.flag.firstCold) { state.flag.firstCold = true;
            unlockAchievement('【好冷啊——】'); }
        if (w.name === '暴风雪' && !state.flag.firstBlizzard) { state.flag.firstBlizzard = true;
            unlockAchievement('【要被吹走了——】'); }
        if ((w.name === '雷阵雨' || w.name === '雷电') && !state.flag.firstThunder) { state.flag.firstThunder = true;
            unlockAchievement('【打雷了！】'); }
        if (w.name === '海啸' && state.flag.tsunamiCount === 0) { state.flag.tsunamiCount++;
            unlockAchievement('【海啸来了！】'); }
        if (w.name === '海啸' && state.flag.tsunamiCount === 1) { state.flag.tsunamiCount++;
            unlockAchievement('【海啸又来了！】'); }
        if (w.effect === 'bad') applyDisaster(w);
    }

    function applyDisaster(weather) {
        // 灾害护盾
        if (state.flag.灾害护盾 > 0) {
            if (state.flag.灾害护盾 > 0) state.flag.灾害护盾--;
            addEvent('🛡️ 灾害护盾生效，损失减少', true);
            return;
        }
        let popLoss = 0,
            foodLoss = 0,
            houseDamage = 0,
            farmLoss = 0;
        const severity = Math.random();
        let reduction = Math.min(0.5, state.roadKm / 1000 * 0.1);
        if (['台风', '龙卷风', '热带风暴'].includes(weather.name)) {
            popLoss = Math.floor(state.population * (0.02 + severity * 0.08) * (1 - reduction));
            foodLoss = Math.floor(state.food * (0.05 + severity * 0.15) * (1 - reduction));
            houseDamage = Math.floor((state.houses[0] + state.houses[1] + state.houses[2]) * 0.1 * (1 - reduction));
            farmLoss = Math.floor(state.farmland * 0.05);
        } else if (['暴风雪', '寒潮'].includes(weather.name)) {
            popLoss = Math.floor(state.population * (0.01 + severity * 0.06) * (1 - reduction));
            foodLoss = Math.floor(state.food * (0.10 + severity * 0.20) * (1 - reduction));
            farmLoss = Math.floor(state.farmland * 0.03);
        } else if (['洪水', '海啸'].includes(weather.name)) {
            popLoss = Math.floor(state.population * (0.03 + severity * 0.10) * (1 - reduction));
            foodLoss = Math.floor(state.food * 0.20 * (1 - reduction));
            houseDamage = Math.floor((state.houses[0] + state.houses[1] + state.houses[2]) * 0.15 * (1 - reduction));
            farmLoss = Math.floor(state.farmland * 0.08);
            state.flag.floodCount++;
            if (state.flag.floodCount >= 3) unlockAchievement('【防线全面崩溃】');
        } else if (weather.name === '干旱') {
            foodLoss = Math.floor(state.food * (0.20 + severity * 0.30) * (1 - reduction));
            farmLoss = Math.floor(state.farmland * 0.05);
        } else if (weather.name === '冰雹') {
            foodLoss = Math.floor(state.food * 0.10 * (1 - reduction));
            popLoss = Math.floor(state.population * 0.01 * (1 - reduction));
            farmLoss = Math.floor(state.farmland * 0.02);
        } else if (weather.name === '高温') {
            popLoss = Math.floor(state.population * 0.02 * (1 - reduction));
            state.flag.heatWaveDays += state.weather.duration;
            if (state.flag.heatWaveDays >= 15) unlockAchievement('【高温黄色预警】');
            if (state.flag.heatWaveDays >= 25) unlockAchievement('【高温橙色预警】');
            if (state.flag.heatWaveDays >= 30) unlockAchievement('【高温红色预警】');
        } else if (weather.name === '地震') {
            popLoss = Math.floor(state.population * (0.05 + severity * 0.15) * (1 - reduction));
            houseDamage = Math.floor((state.houses[0] + state.houses[1] + state.houses[2]) * 0.20 * (1 - reduction));
            state.flag.earthquakeCount++;
            if (state.flag.earthquakeCount >= 3 && state.date.year < 1) unlockAchievement('【地震专业户】');
        }
        if (state.population - popLoss < 1) popLoss = state.population - 1;
        state.population -= popLoss;
        state.food = Math.max(0, state.food - foodLoss);
        state.farmland = Math.max(0, state.farmland - farmLoss);
        if (houseDamage > 0) {
            let total = state.houses[0] + state.houses[1] + state.houses[2];
            if (total > 0) {
                let dmg = Math.min(houseDamage, total);
                for (let i = 0; i < 3; i++) {
                    let reduce = Math.min(state.houses[i], dmg);
                    state.houses[i] -= reduce;
                    dmg -= reduce;
                    if (dmg <= 0) break;
                }
            }
        }
        if (state.population <= 0) unlockAchievement('【啊哦，重开吧】');
        if (state.food <= 0) unlockAchievement('【好……饿……啊……】');
        addEvent('💥 ' + weather.name + ' 损失: 人口-' + popLoss + ', 粮食-' + foodLoss + ', 耕地-' + farmLoss, true);
        updateUI();
    }

    // =====================================================================
    //  疫情
    // =====================================================================
    function pandemicTick() {
        if (state.pandemic.active) {
            state.pandemic.daysLeft--;
            let deaths = rand(1, 600) - state.tech * 2;
            deaths = Math.max(0, deaths);
            state.population = Math.max(1, state.population - deaths);
            if (state.population <= 1) unlockAchievement('【全员阵亡……】');
            if (state.pandemic.daysLeft <= 0) {
                state.pandemic.active = false;
                unlockAchievement('【最可爱的人】');
                addEvent('🦠 疫情结束！', true);
            }
            return;
        }
        if (state.date.month === 1 && state.date.day === 1 && state.date.year >= 4) {
            let idx = state.pandemic.index;
            let prob = 0.0001 + idx * 0.001;
            if (Math.random() < prob) {
                let duration = 30 + rand(0, 60) - state.tech * 5;
                duration = Math.max(15, duration);
                state.pandemic.active = true;
                state.pandemic.daysLeft = duration;
                state.pandemic.index = 0;
                if (!state.flag.firstPandemic) { state.flag.firstPandemic = true;
                    unlockAchievement('【疫情公司】'); }
                addEvent('🦠 疫情爆发！持续 ' + duration + ' 天', true);
                if (duration > 365) unlockAchievement('【哦不！口罩事件！】');
            } else {
                let bad = state.weather.effect === 'bad' ? 1 : 0;
                if (bad > 0 && bad <= 15) state.pandemic.index += 0.5;
                else if (bad > 15 && bad <= 30) state.pandemic.index += 1;
                else if (bad > 30) state.pandemic.index += 2;
                else state.pandemic.index += 1;
            }
        }
    }

    // =====================================================================
    //  人口增长
    // =====================================================================
    function growPopulation() {
        if (state.population <= 0) return;
        let foodProd = (state.farmland * 5) + (state.lumberLevel * 0.5);
        let houseTotal = state.houses[0] * 50 + state.houses[1] * 100 + state.houses[2] * 600;
        let growth = Math.floor((foodProd * 0.4) + (houseTotal * 0.32));
        if (growth < 0) growth = 0;
        if (state.date.year < 3) {
            state.population += growth;
        } else {
            let homeless = Math.max(0, state.population - houseTotal);
            if (homeless > 0 && Math.random() < 0.03) {
                state.population -= Math.floor(homeless * 0.03);
            } else {
                state.population += growth;
            }
            // 饥荒
            if (state.food < 50 && state.farmland < 30 && Math.random() < 0.2) {
                let loss = Math.min(Math.floor(state.population * 0.05), state.population - 1);
                state.population -= loss;
                state.famineLevel = 2;
                if (state.famineLevel === 2) unlockAchievement('【蛋白质是牛肉的四五倍】');
                addEvent('⚠️ 饥荒II: 人口-' + loss, true);
            } else if (state.food < 30 && state.farmland < 15 && Math.random() < 0.38) {
                let loss = Math.min(Math.floor(state.population * 0.08), state.population - 1);
                state.population -= loss;
                state.famineLevel = 1;
                if (state.famineLevel === 1) unlockAchievement('【这是一个艰难的时代】');
                addEvent('⚠️ 饥荒I: 人口-' + loss, true);
            }
        }
        if (state.population < 1) state.population = 1;
        let laborRate = 0.5 + (state.happiness / 100) * 0.25;
        state.labor = Math.floor(state.population * laborRate);
        if (state.labor < 0) state.labor = 0;
        if (state.army > 0) {
            let foodCost = Math.floor(state.army * 0.185);
            state.food = Math.max(0, state.food - foodCost);
        }
        if (state.population < 1000) state.happiness = Math.max(0, state.happiness - 0.1);
        let houseTotal2 = state.houses[0] * 50 + state.houses[1] * 100 + state.houses[2] * 600;
        if (state.population > 0 && houseTotal2 > 0 && (state.population / houseTotal2) < 0.1) {
            state.happiness = Math.max(0, state.happiness - 0.1);
            unlockAchievement('【好孤独…好寂寞…】');
        }
        state.happiness = Math.min(100, Math.max(0, state.happiness));
        // 人口成就
        if (state.population >= 100) unlockAchievement('【百村联盟】');
        if (state.population >= 1000) unlockAchievement('【千人之城】');
        if (state.population >= 10000) unlockAchievement('【万人之上】');
        if (state.population >= 100000) unlockAchievement('【十万百姓】');
        if (state.population >= 1000000) unlockAchievement('【百万雄师过大江】');
        if (state.population >= 10000000) unlockAchievement('【千万人口】');
        if (state.population >= 100000000) unlockAchievement('【亿人之上】');
        updateUI();
    }

    // =====================================================================
    //  资源产出
    // =====================================================================
    function produceResources() {
        let levels = [0, 3, 5, 8, 13, 23, 30, 38, 47, 57, 68, 80, 93, 107, 122, 138, 155, 173, 192, 212, 233, 255, 278, 302,
            327, 353, 380, 408, 437, 467, 498
        ];
        let woodProd = levels[Math.min(state.lumberLevel, 30)] || 3;
        let mineLevels = [0, 6, 10, 16, 80, 92, 120, 135, 152, 171, 192, 215, 240, 267, 296, 327, 360, 395, 432, 471, 512,
            555, 600, 647, 696, 747, 800, 855, 912, 971, 1032
        ];
        let oreProd = mineLevels[Math.min(state.mineLevel, 30)] || 0;
        state.wood += woodProd;
        state.ore += oreProd;
        let foodFromFarm = state.farmland * 5;
        if (state.weather.effect === 'good') foodFromFarm = Math.floor(foodFromFarm * 1.2);
        else if (state.weather.effect === 'bad') foodFromFarm = Math.floor(foodFromFarm * 0.5);
        state.food += Math.max(0, foodFromFarm);
        // 经济
        let moneyIncome = Math.floor(state.labor * 0.5) + Math.floor(state.happiness * 0.1) + Math.floor(state.food * 0.01);
        moneyIncome = Math.floor(moneyIncome * state.taxRate);
        state.money += Math.max(0, moneyIncome);
        // 科技
        if (state.lumberLevel >= 1 && !state.flag.hasLumber) {
            state.flag.hasLumber = true;
            state.tech += 1;
            unlockAchievement('【伐伐伐伐伐木工】');
        }
        if (state.mineLevel >= 1 && !state.flag.hasMine) {
            state.flag.hasMine = true;
            state.tech += 3;
            unlockAchievement('【You are mine.】');
        }
        if (state.wood >= 10000 && state.ore >= 10000 && state.steel >= 10000 && state.roadKm >= 10000) {
            unlockAchievement('【想成功，先发疯】');
        }
        if (state.money >= 1000) unlockAchievement('【第一桶金】');
        if (state.money >= 10000) unlockAchievement('【万元户】');
        if (state.money >= 30000) unlockAchievement('【经济！搞经济！】');
        if (state.money >= 10000000) unlockAchievement('【富可敌国】');
        if (state.money >= 100000000) unlockAchievement('【富可敌球】');
        // 十全十美
        let vals = [state.population, state.money, state.tech, state.roadKm, state.army, state.happiness, state.wood, state
            .ore, state.steel, state.farmland
        ];
        let count = vals.filter(v => v >= 10000).length;
        if (count >= 10) unlockAchievement('【十全十美】');
        if (state.population >= 10000 && state.money >= 10000 && state.tech >= 10000 && state.roadKm >= 10000 && state
            .army >= 10000 && state.happiness >= 10000) {
            unlockAchievement('【六边形战士】');
        }
        // 健康度
        if (state.hospitals > 0 && state.health < 100) {
            let recover = state.hospitals * 10 + state.medicalFee / 10 + (state.freeMedical ? 15 : 0);
            state.health = Math.min(100, state.health + recover / 365);
        } else if (state.hospitals === 0 && state.health > 0) {
            state.health = Math.max(0, state.health - 0.05);
        }
        state.health = clamp(state.health, 0, 100);
        // 犯罪
        state.crimeRate = Math.max(0, state.crimeRate - 0.01);
        updateUI();
    }

    // =====================================================================
    //  Tick
    // =====================================================================
    function tick() {
        if (state.paused) return;
        state.date.dayCount++;
        state.date.day++;
        if (state.date.day > 30) { state.date.day = 1;
            state.date.month++; }
        if (state.date.month > 12) { state.date.month = 1;
            state.date.year++; }
        updateWeather();
        growPopulation();
        produceResources();
        pandemicTick();
        // 公路维护
        if (state.roadKm > 0 && state.date.day % 30 === 0) {
            let cost = Math.floor(state.roadKm * 1);
            let moneyCost = Math.floor(state.roadKm * 10);
            if (state.steel >= cost && state.money >= moneyCost) {
                state.steel -= cost;
                state.money -= moneyCost;
                unlockAchievement('【按规交保险】');
            } else {
                state.roadDurability = Math.max(0, state.roadDurability - 10);
                if (state.roadDurability === 0) unlockAchievement('【报废了！！】');
            }
        }
        // 房屋维护
        if (state.houses[1] > 0 && state.date.month === 1 && state.date.day === 1) {
            let need = state.houses[1] * 50;
            if (state.steel >= need && state.wood >= need && state.money >= state.houses[1] * 1600) {
                state.steel -= need;
                state.wood -= need;
                state.money -= state.houses[1] * 1600;
            } else {
                state.houses[1] = Math.max(0, state.houses[1] - 1);
            }
        }
        if (state.houses[0] > 0 && state.date.day % 15 === 0) {
            let need = state.houses[0] * 15;
            if (state.steel >= need && state.money >= state.houses[0] * 360) {
                state.steel -= need;
                state.money -= state.houses[0] * 360;
            } else {
                state.houses[0] = Math.max(0, state.houses[0] - 1);
            }
        }
        // 自动参军
        let possible = Math.floor(state.population * 0.08);
        let join = Math.floor(possible * 0.30);
        if (join > 0 && state.food > 100) {
            state.army += join;
            state.population -= join;
            if (state.army >= 1) unlockAchievement('【新兵小子】');
            if (state.army >= 100) unlockAchievement('【百夫长】');
            if (state.army >= 1000) unlockAchievement('【千军万马】');
            if (state.army >= 100000) unlockAchievement('【十万大军】');
            if (state.army >= 1000000) unlockAchievement('【百万雄师】');
            if (state.army >= 10000000) unlockAchievement('【钢铁洪流·终极】');
        }
        if (state.kuangyi.cooldown > 0) state.kuangyi.cooldown--;
        // 治安
        if (state.crimeRate > 60 && Math.random() < 0.02) {
            state.crimeEvent.active = true;
            state.crimeEvent.daysLeft = rand(3, 7);
            addEvent('🚔 治安事件！', true);
            if (state.crimeRate > 80) unlockAchievement('【Rock star】');
        }
        if (state.crimeEvent.active) {
            state.crimeEvent.daysLeft--;
            if (state.crimeEvent.daysLeft <= 0) state.crimeEvent.active = false;
        }
        // 成就
        if (state.date.dayCount >= 100) unlockAchievement('【与天斗其乐无穷】');
        if (state.date.dayCount >= 3650) unlockAchievement('【十年之约】');
        if (state.date.dayCount >= 36500) { unlockAchievement('【百年国祚】');
            unlockAchievement('【千秋万代】'); }
        if (state.date.dayCount >= 365000) unlockAchievement('【万岁万岁万万岁】');
        if (state.date.year >= 3) unlockAchievement('【恭喜你！出新手村了！】');
        // 护盾
        if (state.flag.治安护盾 > 0) state.flag.治安护盾--;
        if (state.flag.灾害护盾 > 0) state.flag.灾害护盾--;
        if (state.flag.清洁护盾 > 0) state.flag.清洁护盾--;
        state.flag.lastActionTime++;
        if (state.flag.lastActionTime > 365 && state.flag.noOperation) {
            unlockAchievement('【你在找什么？登录按钮吗？】');
            state.flag.noOperation = false;
        }
        updateUI();
    }

