    //  辅助
    // =====================================================================
    function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

    function pick(arr) { return arr[rand(0, arr.length - 1)]; }

    function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

    function addEvent(msg, highlight) {
        let log = document.getElementById('eventLog');
        let div = document.createElement('div');
        div.innerHTML = msg;
        if (highlight) div.style.color = '#e8c860';
        log.prepend(div);
        if (log.children.length > 40) log.removeChild(log.lastChild);
    }

    function unlockAchievement(name) {
        if (!state.achievements.includes(name)) {
            state.achievements.push(name);
            addEvent('🏆 解锁: ' + name, true);
            // 开发者坦白
            if (name === '【与天斗其乐无穷】') {
                state.confessions.push('📜 开发者坦白(一): 你好。能看到这段文字，就说明你玩这个游戏玩得很好——吧？这段文字原定的触发条件是达成成就【消耗战】，但确实太难了，对吧？鉴于你如此热爱这个游戏，我就跟你坦（bao）白（liao）一件事——我经常在写C++时用unsigned long long定义变量。——关注lkjy。');
