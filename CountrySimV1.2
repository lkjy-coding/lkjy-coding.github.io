            327, 353, 380, 408, 437, 467, 498
        ];
        document.getElementById('lumberProd').innerText = levels[Math.min(state.lumberLevel, 30)] || 3;
        let mineLevels = [0, 6, 10, 16, 80, 92, 120, 135, 152, 171, 192, 215, 240, 267, 296, 327, 360, 395, 432, 471, 512,
            555, 600, 647, 696, 747, 800, 855, 912, 971, 1032
        ];
        document.getElementById('mineProd').innerText = mineLevels[Math.min(state.mineLevel, 30)] || 0;
        document.getElementById('lumberLevel').innerText = state.lumberLevel;
