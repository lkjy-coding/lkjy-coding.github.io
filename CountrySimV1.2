        state.achievements.forEach(a => {
            let desc = ACH_DESC[a] || '';
            achHtml += '<div class="ach-item">' + a + '<span class="ach-desc">' + desc + '</span></div>';
        });
        document.getElementById('achievementList').innerHTML = achHtml || '尚无成就';
        let confHtml = '';
        state.confessions.forEach(c => {
            confHtml += '<div class="confession-item">' + c + '</div>';
        });
        document.getElementById('developerConfession').innerHTML = confHtml;
    }

    function addEvent(msg, highlight) {
        let log = document.getElementById('eventLog');
        let div = document.createElement('div');
        div.innerHTML = msg;
        if (highlight) div.style.color = '#e8c860';
        log.prepend(div);
        if (log.children.length > 40) log.removeChild(log.lastChild);
    }

    // =====================================================================
    //  操作函数
    // =====================================================================
    function recordAction() {
        state.flag.lastActionTime = 0;
        state.flag.noOperation = false;
        state.flag.actionCount++;
    }

    function buildVillage() {
        if (state.wood < 50 || state.money < 2300) { addEvent('❌ 资源不足'); return; }
        state.wood -= 50;
        state.money -= 2300;
        state.houses[0] += 1;
        state.flag.totalHousesBuilt++;
        if (!state.flag.firstHouse) { state.flag.firstHouse = true;
            unlockAchievement('【开家酒店！】'); }
        if (state.flag.totalHousesBuilt >= 100) unlockAchievement('【基建狂魔】');
        if (state.flag.totalHousesBuilt >= 1000) unlockAchievement('【基建狂人】');
        if (state.flag.totalHousesBuilt >= 10000) unlockAchievement('【基建魔鬼】');
        if (state.flag.totalHousesBuilt >= 500) unlockAchievement('【广厦千万间】');
        recordAction();
        addEvent('🏡 木屋建成');
        updateUI();
    }

    function buildStoneHouse() {
        if (state.wood < 30 || state.steel < 30 || state.money < 6000) { addEvent('❌ 资源不足'); return; }
        state.wood -= 30;
        state.steel -= 30;
        state.money -= 6000;
        state.houses[1] += 1;
        state.flag.totalHousesBuilt++;
        if (!state.flag.firstHouse) { state.flag.firstHouse = true;
            unlockAchievement('【开家酒店！】'); }
        if (state.flag.totalHousesBuilt >= 100) unlockAchievement('【基建狂魔】');
        recordAction();
        addEvent('🏰 牢固房屋建成');
        updateUI();
    }

    function buildStrongHouse() {
        if (state.steel < 150 || state.money < 36000) { addEvent('❌ 资源不足'); return; }
        state.steel -= 150;
        state.money -= 36000;
        state.houses[2] += 1;
        state.flag.totalHousesBuilt++;
        if (!state.flag.firstHouse) { state.flag.firstHouse = true;
            unlockAchievement('【开家酒店！】'); }
        if (state.flag.totalHousesBuilt >= 100) unlockAchievement('【基建狂魔】');
        recordAction();
        addEvent('🏯 坚固房屋建成');
        updateUI();
    }

    function buildFarm() {
        if (state.wood < 2) { addEvent('❌ 木材不足'); return; }
        state.wood -= 2;
        state.farmland += 1;
        if (state.farmland === 1) unlockAchievement('【面朝黄土背朝天】');
        if (state.farmland >= 10000) unlockAchievement('【良田千顷】');
        if (state.farmland >= 1000000) unlockAchievement('【万亩良田】');
        if (state.farmland >= 100000000) unlockAchievement('【神农在世】');
        if (state.farmland === 404) unlockAchievement('【Not Found】');
        recordAction();
        addEvent('🌱 耕地+1㎡');
        updateUI();
    }

    function upgradeLumber() {
        let costs = [0, 0, 60, 1360, 2200, 4350, 6800, 12000, 22000, 40000, 75000, 140000, 260000, 480000, 880000, 1600000,
            3000000, 5500000, 10000000, 18000000, 33000000, 60000000, 110000000, 200000000, 360000000, 650000000,
            1200000000, 2200000000, 4000000000, 7500000000, 14000000000
        ];
        let next = state.lumberLevel + 1;
        if (next > 30) { addEvent('⚠️ 已达满级'); return; }
        if (state.wood < costs[next]) { addEvent('❌ 木材不足'); return; }
        state.wood -= costs[next];
        state.lumberLevel = next;
        if (next === 30) unlockAchievement('【惹我光头强，揍你没商量】');
        recordAction();
        addEvent('🪓 伐木场 Lv.' + next);
        updateUI();
    }

    function upgradeMine() {
        let costs = [0, 0, 180, 4080, 19800, 25400, 81600, 120000, 220000, 400000, 750000, 1400000, 2600000, 4800000,
            8800000, 16000000, 30000000, 55000000, 100000000, 180000000, 330000000, 600000000, 1100000000, 2000000000,
            3600000000, 6500000000, 12000000000, 22000000000, 40000000000, 75000000000, 140000000000
        ];
        let next = state.mineLevel + 1;
        if (next > 30) { addEvent('⚠️ 已达满级'); return; }
        if (state.ore < costs[next]) { addEvent('❌ 矿石不足'); return; }
        state.ore -= costs[next];
        state.mineLevel = next;
        if (next === 30) unlockAchievement('【Mine!All Mine!】');
        if (state.mineLevel >= 3) unlockAchievement('【家里有矿】');
        recordAction();
        addEvent('⛏️ 采矿场 Lv.' + next);
        updateUI();
    }

    function buildRoad() {
        if (state.steel < 3 || state.money < 80) { addEvent('❌ 资源不足'); return; }
        state.steel -= 3;
        state.money -= 80;
        state.roadKm += 1;
        state.roadDurability += 100;
        if (state.roadKm === 1) { unlockAchievement('【要致富，先修路】');
            unlockAchievement('【要想富，先修路】'); }
        if (state.roadKm >= 50) unlockAchievement('【这是一条神奇的天路哎——】');
        if (state.roadKm >= 100) unlockAchievement('【条条大路通罗马】');
        if (state.roadKm >= 40000) unlockAchievement('【世界第八大奇迹】');
        recordAction();
        addEvent('🛤️ 交通 +1km');
        updateUI();
    }

    function recruitArmy() {
        if (state.population < 10) { addEvent('❌ 人口不足'); return; }
        let cost = Math.floor(state.population * 0.05);
        if (state.food < cost) { addEvent('❌ 粮食不足'); return; }
        state.food -= cost;
        let recruits = Math.floor(state.population * 0.02) + 1;
        state.army += recruits;
        state.population -= recruits;
        if (!state.flag.firstArmy) { state.flag.firstArmy = true;
            unlockAchievement('【我们的征途是星辰大海】'); }
        if (state.army >= 108) unlockAchievement('【我这人各个有情有义】');
        if (state.army >= 1) unlockAchievement('【新兵小子】');
        if (state.army >= 100) unlockAchievement('【百夫长】');
        if (state.army >= 1000) unlockAchievement('【千军万马】');
        if (state.army >= 100000) unlockAchievement('【十万大军】');
        if (state.army >= 1000000) unlockAchievement('【百万雄师】');
        if (state.army >= 10000000) unlockAchievement('【钢铁洪流·终极】');
        recordAction();
        addEvent('⚔️ 招募 ' + recruits + ' 人');
        updateUI();
    }

    function synthesizeSteel() {
        if (state.ore < 2) { addEvent('❌ 矿石不足'); return; }
        state.ore -= 2;
        state.steel += 1;
        if (state.steel === 1) unlockAchievement('【获得升级】');
        recordAction();
        addEvent('🧱 合成钢筋');
        updateUI();
    }

    function techResearch() {
        if (state.wood < 5 || state.ore < 8) { addEvent('❌ 资源不足'); return; }
        state.wood -= 5;
        state.ore -= 8;
        state.tech += 2;
        recordAction();
        addEvent('🔬 科技+2');
        if (state.tech >= 10) unlockAchievement('【燧人氏】');
        if (state.tech >= 50) unlockAchievement('【四大发明】');
        if (state.tech >= 100) unlockAchievement('【工业革命】');
        if (state.tech >= 500) unlockAchievement('【信息时代】');
        if (state.tech >= 1000) unlockAchievement('【星辰大海】');
        if (state.tech >= 10000) unlockAchievement('【星际迷航】');
        if (state.tech >= 2233) unlockAchievement('【2233】');
        updateUI();
    }

    function kuangyiAction() {
        if (state.kuangyi.cooldown > 0) { addEvent('⏳ 冷却中'); return; }
        state.kuangyi.cooldown = 30;
        state.kuangyi.count++;
        let success = Math.random() < 0.4 + state.tech * 0.01;
        if (success) {
            state.happiness = Math.min(100, state.happiness + 5);
            state.tech += 1;
            state.kuangyi.successCount++;
            state.kuangyi.consecutiveSuccess++;
            unlockAchievement('【大捷！】');
            if (state.kuangyi.successCount >= 3) unlockAchievement('【我一分都没敢花，穷怕了】');
            if (state.kuangyi.successCount >= 5) unlockAchievement('【摆正身位】');
            if (state.kuangyi.consecutiveSuccess >= 3) unlockAchievement('【这是攒了多久】');
            addEvent('⚡ 匡义成功', true);
        } else {
            state.happiness = Math.max(0, state.happiness - 8);
            state.tech = Math.max(0, state.tech - 1);
            state.kuangyi.consecutiveSuccess = 0;
            addEvent('⚡ 匡义失败', true);
        }
        if (state.kuangyi.count === 1) unlockAchievement('【匡义！】');
        if (state.kuangyi.count >= 3650) unlockAchievement('【消耗战】');
        recordAction();
        updateUI();
    }

    function buyAC() {
        if (state.money < 320) { addEvent('❌ 钱不足'); return; }
        state.money -= 320;
        if (!state.flag.firstAC) { state.flag.firstAC = true;
            unlockAchievement('【是空调！我加了点空调！】'); }
        if (state.flag.heatWaveDays >= 15) unlockAchievement('【台下观众欣喜若狂啊】');
        recordAction();
        addEvent('❄️ 购买空调');
        updateUI();
    }

    function buildHospital() {
        if (state.money < 32000 || state.steel < 3600) { addEvent('❌ 资源不足'); return; }
        state.money -= 32000;
        state.steel -= 3600;
        state.hospitals += 1;
        if (!state.flag.firstHospital) { state.flag.firstHospital = true;
            unlockAchievement('【免费医疗，普惠大众！】'); }
        recordAction();
        addEvent('🏥 医院建成');
        updateUI();
    }

    function toggleFreeMedical() {
        state.freeMedical = !state.freeMedical;
        if (state.freeMedical) unlockAchievement('【免费医疗，普惠大众！】');
        recordAction();
        addEvent('💊 免费医疗 ' + (state.freeMedical ? '开启' : '关闭'));
        updateUI();
    }

    function crimeCrack() {
        if (state.crimeEvent.active) {
            state.crimeEvent.active = false;
            state.crimeRate = Math.max(0, state.crimeRate - 10);
            if (!state.flag.firstCrime) { state.flag.firstCrime = true;
                unlockAchievement('【Catch catch】'); }
            recordAction();
            addEvent('🚔 犯罪嫌疑人被捕！');
            updateUI();
        } else {
            addEvent('⚠️ 无治安事件');
        }
    }

    function sellResource() {
        let sold = false;
        if (state.food > 100) { let s = Math.min(state.food - 100, 50);
            state.food -= s;
            state.money += s * state.priceFood;
            addEvent('💰 卖出 ' + s + ' 粮食');
            sold = true; } else if (state.wood > 10) { let s = Math.min(state.wood - 10, 20);
            state.wood -= s;
            state.money += s * state.priceWood;
            addEvent('💰 卖出 ' + s + ' 木材');
            sold = true; } else if (state.ore > 10) { let s = Math.min(state.ore - 10, 20);
            state.ore -= s;
            state.money += s * state.priceOre;
            addEvent('💰 卖出 ' + s + ' 矿石');
            sold = true; } else if (state.steel > 5) { let s = Math.min(state.steel - 5, 10);
            state.steel -= s;
            state.money += s * state.priceSteel;
            addEvent('💰 卖出 ' + s + ' 钢筋');
            sold = true; }
        if (!sold) addEvent('❌ 无可售资源');
        if (sold) { recordAction();
            updateUI(); }
    }

    function setTax() {
        let newRate = prompt('输入税率 (0-50):', Math.floor(state.taxRate * 100));
        if (newRate === null) return;
        let r = parseFloat(newRate) / 100;
        if (isNaN(r) || r < 0 || r > 0.5) { addEvent('❌ 税率无效'); return; }
        state.taxRate = r;
        if (r === 0) unlockAchievement('【没有税收的我们国家】');
        if (r === 0.2) unlockAchievement('【常税将军】');
        if (r === 0.5) unlockAchievement('【大楚兴，陈胜王】');
        recordAction();
        addEvent('📊 税率 ' + Math.floor(r * 100) + '%');
        updateUI();
    }

    function forceWeather() {
        updateWeather();
        recordAction();
    }

    function addDiplomacy() {
        let chance = Math.min(80, 30 + state.tech * 0.5 + state.army * 0.1 + state.roadKm * 0.05);
        if (Math.random() * 100 < chance) {
            state.diplomacy.allies += 1;
            state.flag.totalDiplomacy++;
            if (!state.flag.firstDiplomacy) { state.flag.firstDiplomacy = true;
                unlockAchievement('【幸会幸会】'); }
            if (state.diplomacy.allies >= 3) unlockAchievement('【亻尔女子】');
            if (state.diplomacy.allies >= 30) unlockAchievement('【朋友满天下】');
            if (state.diplomacy.allies >= 50) unlockAchievement('【编者还欠费功夫】');
            if (state.flag.noDiplomacy) { state.flag.noDiplomacy = false; }
            addEvent('🤝 建交成功！');
        } else {
            state.diplomacy.peaceCount += 1;
            if (state.diplomacy.peaceCount === 1) unlockAchievement('【爱来不来！】');
            addEvent('💔 断交...');
        }
        recordAction();
        updateUI();
    }

    function triggerDisaster() {
        let w = pick(['台风', '龙卷风', '暴风雪', '寒潮', '洪水', '干旱', '冰雹', '高温', '海啸', '地震']);
        state.weather = { name: w, type: 'storm', effect: 'bad', duration: rand(1, 3) };
        applyDisaster(state.weather);
        recordAction();
    }

    function toggleSpeed() {
        let btn = document.getElementById('speedBtn');
        if (state.speed === 1) { state.speed = 5;
            btn.innerText = '⏩ 5x'; } else if (state.speed === 5) { state.speed = 20;
            btn.innerText = '⏩ 20x'; } else if (state.speed === 20) { state.speed = 60;
            btn.innerText = '⏩ 60x'; } else { state.speed = 1;
            btn.innerText = '⏩ 1x'; }
        applySpeed();
    }

    // =====================================================================
    //  商店
    // =====================================================================
    function openShop() {
        let msg = '🏪 道具商店 (虚拟货币，无充值)\n\n';
        msg += '治安护盾(30日) - 76500货币\n[不发生隐蔽治安事件，每20日随机一次]\n\n';
        msg += '灾害护盾(30日) - 58600货币\n[灾害3日无伤亡，损失-55%]\n\n';
        msg += '清洁护盾(30日) - 98860货币\n[腐败度>10时归零，损失-75%]\n\n';
        msg += '木房屋修缮(1份) - 6000货币\n[剩余寿命<3年时恢复至设计寿命]\n\n';
        msg += '牢固房屋修缮(1份) - 9500货币\n[剩余寿命<3年时恢复至设计寿命]\n\n';
        msg += '十分坚固房屋修缮(1份) - 16000货币\n[剩余寿命<3年时恢复至设计寿命]\n\n';
        msg += '救灾皮划艇(1份) - 75000货币\n[人员损失-60%，田地损失-15%]\n\n';
        msg += '房屋修缮建材包(3份) - 96000货币\n[剩余寿命<2年时+1年，10日冷却]\n\n';
        msg += '钢化玻璃大棚(1份) - 120000货币\n[保护10㎡耕地，灾害坚持5-20日]\n\n';
        msg += '100货币 - 50木材\n';
        msg += '150货币 - 25矿石\n';
        msg += '180货币 - 30钢筋\n';
        let choice = prompt(msg + '\n输入编号购买:\n1.治安护盾 2.灾害护盾 3.清洁护盾 4.木修缮 5.牢修缮 6.坚修缮 7.皮划艇 8.建材包 9.大棚 10.买钱(木) 11.买钱(矿) 12.买钱(钢)');
        if (!choice) return;
        let num = parseInt(choice);
        if (num === 1 && state.money >= 76500) { state.money -= 76500;
            state.flag.治安护盾 = 30;
            addEvent('🛡️ 治安护盾 30日'); } else if (num === 2 && state.money >= 58600) { state.money -= 58600;
            state.flag.灾害护盾 = 30;
            addEvent('🛡️ 灾害护盾 30日'); } else if (num === 3 && state.money >= 98860) { state.money -= 98860;
            state.flag.清洁护盾 = 30;
            addEvent('🛡️ 清洁护盾 30日'); } else if (num === 4 && state.money >= 6000) { state.money -= 6000;
            addEvent('🔧 木房屋修缮'); } else if (num === 5 && state.money >= 9500) { state.money -= 9500;
            addEvent('🔧 牢固房屋修缮'); } else if (num === 6 && state.money >= 16000) { state.money -= 16000;
            addEvent('🔧 坚固房屋修缮'); } else if (num === 7 && state.money >= 75000) { state.money -= 75000;
            addEvent('🚣 救灾皮划艇'); } else if (num === 8 && state.money >= 96000) { state.money -= 96000;
            addEvent('📦 建材包'); } else if (num === 10 && state.wood >= 50) { state.wood -= 50;
            state.money += 100;
            addEvent('💰 换钱'); } else if (num === 11 && state.ore >= 25) { state.ore -= 25;
            state.money += 150;
            addEvent('💰 换钱'); } else if (num === 12 && state.steel >= 30) { state.steel -= 30;
            state.money += 180;
            addEvent('💰 换钱'); } else { addEvent('❌ 购买失败'); }
        updateUI();
    }

    // =====================================================================
    //  兑换码
    // =====================================================================
    function openRedeem() {
        let code = prompt('🎁 输入兑换码:');
        if (!code) return;
        if (code === '官方话题登榜第一' && !state.redeemedCodes.includes(code)) {
            state.redeemedCodes.push(code);
            unlockAchievement('【This is OUR game!】');
            addEvent('🎁 兑换成功！获得成就+坦白(五)', true);
        } else if (code === 'lkjy制造' && !state.redeemedCodes.includes(code)) {
            state.redeemedCodes.push(code);
            unlockAchievement('【Rare Made】');
            state.money += 36800;
            state.wood += 5000;
            state.steel += 2500;
            confirm('你已获得lkjy私信一对一解答三次的权限！截图通过AC Chat发送给lkjy，看到后会答复。');
            addEvent('🎁 兑换成功！', true);
        } else if (code === 'ALways popular' && !state.redeemedCodes.includes(code)) {
            state.redeemedCodes.push(code);
            state.flag.治安护盾 = 180;
            state.flag.灾害护盾 = 90;
            state.flag.清洁护盾 = 100;
            state.money += 46500;
            addEvent('🎁 兑换成功！三护盾激活！', true);
        } else {
            addEvent('❌ 无效兑换码或已使用');
        }
        updateUI();
    }

    // =====================================================================
    //  存档
    // =====================================================================
    function exportSave() {
        try {
            let data = JSON.stringify(state);
            let blob = new Blob([data], { type: 'text/plain' });
            let a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'save_' + state.date.year + '_' + state.date.month + '_' + state.date.day + '.txt';
            a.click();
            state.flag.exportCount++;
            unlockAchievement('【Check out】');
            addEvent('💾 存档已导出');
        } catch (e) {
            addEvent('❌ 导出失败');
            unlockAchievement('【Oh myy pccccccc】');
        }
    }

    document.getElementById('fileInput').addEventListener('change', function(e) {
        let file = e.target.files[0];
        if (!file) return;
        let reader = new FileReader();
        reader.onload = function(ev) {
            try {
                let data = JSON.parse(ev.target.result);
                if (data.population === undefined || data.wood === undefined) {
                    addEvent('❌ 存档校验失败', true);
                    unlockAchievement('【你是不是用了错误的服务器？】');
                    return;
                }
                Object.assign(state, data);
                state.flag.importCount++;
                unlockAchievement('【Check in】');
                addEvent('📂 读档成功！', true);
                updateUI();
            } catch (err) {
                addEvent('❌ 导入失败', true);
                unlockAchievement('【该关些页面了】');
            }
        };
        reader.readAsText(file);
        e.target.value = '';
    });

    function saveHistory() {
        try {
            let data = JSON.stringify(state);
            state.history.push(data);
            if (state.history.length > 20) state.history.shift();
        } catch (e) {}
    }

    document.getElementById('rollbackBtn').addEventListener('click', function() {
        if (state.history.length === 0) { addEvent('⏪ 无回溯点'); return; }
        let last = state.history.pop();
        try {
            let data = JSON.parse(last);
            Object.assign(state, data);
            addEvent('⏪ 回溯成功', true);
            updateUI();
        } catch (e) { addEvent('❌ 回溯失败'); }
    });

    // =====================================================================
    //  初始化
    // =====================================================================
    let tickInterval;

    function applySpeed() {
        if (tickInterval) clearInterval(tickInterval);
        tickInterval = setInterval(tick, 1000 / state.speed);
    }

    function init() {
        // 默认国家名
        let name = prompt('请输入您的国家名称:', '我的国家');
        if (name) state.countryName = name;
        addEvent('🏁 欢迎来到 ' + state.countryName + '！');
        unlockAchievement('【第一话】');
        updateUI();
        document.getElementById('pauseBtn').addEventListener('click', function() {
            state.paused = !state.paused;
            this.innerText = state.paused ? '▶️ 继续' : '⏸️ 暂停';
        });
        applySpeed();
        // 价格波动
        setInterval(() => {
            let r = Math.random() * 100;
            let prices = [
                [0.35, 100],
                [3.65, 70],
                [4.25, 50],
                [4.75, 20],
                [4.65, 10],
                [5.15, 5],
                [38.4, 0],
                [6.45, -5],
                [5.65, -10],
                [6.65, -20],
                [7.85, -50],
                [6.75, -70],
                [5.45, -100]
            ];
            let cum = 0;
            for (let p of prices) {
                cum += p[0];
                if (r <= cum) {
                    let change = p[1] / 100;
                    state.priceWood = Math.max(1, state.priceWood * (1 + change));
                    state.priceOre = Math.max(1, state.priceOre * (1 + change));
                    state.priceSteel = Math.max(1, state.priceSteel * (1 + change));
                    state.priceFood = Math.max(1, state.priceFood * (1 + change));
                    break;
                }
            }
        }, 3000);
        // 无操作检测
        setTimeout(() => {
            if (state.flag.actionCount === 0 && state.date.year >= 1) {
                unlockAchievement('【恭喜你！啥都没动出新手村了！】');
            }
        }, 5000);
    }

    init();
</script>
</body>
</html>
